parameter "ProjectTemplate.Container.Package" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = "Select the container image to deploy."
    label = "Container Image"
}

parameter "ProjectTemplate.Target.Tags" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Enter the target tags for the steps."
    label = "Target Tags"
}

parameter "ProjectTemplate.Namespace.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Enter the namespace that the containers will be deployed to."
    label = "Namespace"
}

parameter "ProjectTemplate.Git.Url" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Url to the git repo to use."
    label = "Git Url"
}

parameter "ProjectTemplate.Git.Service.File.Path" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Path to the Service YAML file."
    label = "Service File Path"
}

parameter "ProjectTemplate.Git.Deployment.File.Path" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Path to the Deployment YAML file."
    label = "Deployment File Path"
}