parameter "ProjectTemplate.Helm.Chart.Package" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = "Select the container image to deploy."
    label = "Container Image"
}

parameter "ProjectTemplate.Helm.Target.Tags" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = "Enter the target tags for the steps."
    label = "Helm Target Tags"
}

parameter "ProjectTemplate.Ingress.Class.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Enter the name of the Ingress Class the deployment requires."
    label = "Ingress Class Name"

    value "traefik" {}
}

parameter "ProjectTemplate.Host.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "The Host Name the Ingress will configured with."
    label = "Host Name"
}